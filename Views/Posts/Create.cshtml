@model PostCreateViewModel

<div class="auth-container">
    <div class="auth-card">
        <div class="glass-card-static animate-fade-in-up" style="padding: 2.5rem;">
            <div class="auth-header">
                <div style="font-size: 2.5rem; margin-bottom: 0.5rem;">✍️</div>
                <h1 class="section-title gradient-text">Create Post</h1>
                <p class="auth-subtitle">Share your fitness knowledge with the community</p>
            </div>

            <form action="Create" method="post">
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Title" class="form-label-dark"></label>
                    <input asp-for="Title" class="form-control-dark" placeholder="Enter post title">
                    <span asp-validation-for="Title" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Description" class="form-label-dark"></label>
                    <input asp-for="Description" class="form-control-dark" placeholder="Brief description">
                    <span asp-validation-for="Description" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Url" class="form-label-dark"></label>
                    <input asp-for="Url" class="form-control-dark" placeholder="post-url-slug">
                    <span asp-validation-for="Url" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Content" class="form-label-dark"></label>
                    <textarea asp-for="Content" class="form-control-dark" rows="6" placeholder="Write your post content..."></textarea>
                    <span asp-validation-for="Content" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-glow w-100">
                    <i class="bi bi-rocket-takeoff-fill"></i> Publish Post
                </button>
            </form>
        </div>
    </div>
</div>