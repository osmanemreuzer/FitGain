@using System.Security.Claims
@model FitGain.Entity.Post 

<div class="delete-card animate-fade-in-up">
    <div class="glass-card-static" style="padding: 2.5rem;">
        <div class="delete-icon">
            <i class="bi bi-exclamation-triangle-fill"></i>
        </div>
        <h2 class="delete-title">Delete Post?</h2>
        <p class="delete-message">
            Are you sure you want to delete 
            <span class="delete-post-name">"@Model.Title"</span>?
            <br>This action cannot be undone.
        </p>

        <form asp-action="Delete" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" asp-for="PostId" />
            <div class="delete-actions">
                <a asp-action="List" class="btn-outline-glass">
                    <i class="bi bi-x-lg"></i> Cancel
                </a>
                <button type="submit" class="btn-danger-glow">
                    <i class="bi bi-trash-fill"></i> Delete
                </button>
            </div>
        </form>
    </div>
</div>