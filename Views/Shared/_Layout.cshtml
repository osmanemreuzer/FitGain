<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - FitGain</title>
    <meta name="description" content="FitGain - Your fitness journey starts here. Share progress, tips, and motivation." />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" rel="stylesheet">

    <!-- Bootstrap & Icons -->
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css">

    <!-- Custom CSS -->
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <!-- NAVBAR -->
    <nav class="navbar-fitgain" id="mainNavbar">
        <div class="container-fluid d-flex justify-content-between align-items-center h-100">
            <!-- Brand -->
            <a href="/posts" class="navbar-brand text-decoration-none">
                🏋️ FitGain
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler-custom d-lg-none" type="button" data-bs-toggle="offcanvas" data-bs-target="#mobileMenu">
                <i class="bi bi-list"></i>
            </button>

            <!-- Desktop Nav -->
            <div class="d-none d-lg-flex align-items-center gap-1">
                @if(User!.Identity!.IsAuthenticated)
                {
                    <a href="/profile/@User.Identity?.Name" class="nav-link-custom">
                        <i class="bi bi-person-circle"></i> @User.Identity?.Name
                    </a>
                    <a href="/posts/list" class="nav-link-custom">
                        <i class="bi bi-grid-3x3-gap-fill"></i> My Posts
                    </a>
                    <a href="/posts/create" class="nav-link-custom">
                        <i class="bi bi-plus-circle-fill"></i> New Post
                    </a>
                    <a href="/users/logout" class="nav-link-custom">
                        <i class="bi bi-box-arrow-right"></i> Logout
                    </a>
                }
                else
                {
                    <a href="/users/login" class="nav-link-custom">
                        <i class="bi bi-box-arrow-in-right"></i> Login
                    </a>
                    <a href="/users/register" class="btn-glow btn-glow-sm">
                        <i class="bi bi-person-plus-fill"></i> Register
                    </a>
                }
            </div>
        </div>
    </nav>

    <!-- Mobile Offcanvas Menu -->
    <div class="offcanvas offcanvas-end" tabindex="-1" id="mobileMenu" style="background: var(--bg-secondary); color: var(--text-primary); border-left: 1px solid var(--border-color);">
        <div class="offcanvas-header" style="border-bottom: 1px solid var(--border-color);">
            <h5 class="offcanvas-title gradient-text">FitGain</h5>
            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="offcanvas"></button>
        </div>
        <div class="offcanvas-body d-flex flex-column gap-2 pt-3">
            @if(User!.Identity!.IsAuthenticated)
            {
                <a href="/profile/@User.Identity?.Name" class="nav-link-custom">
                    <i class="bi bi-person-circle"></i> @User.Identity?.Name
                </a>
                <a href="/posts/list" class="nav-link-custom">
                    <i class="bi bi-grid-3x3-gap-fill"></i> My Posts
                </a>
                <a href="/posts/create" class="nav-link-custom">
                    <i class="bi bi-plus-circle-fill"></i> New Post
                </a>
                <hr style="border-color: var(--border-color);">
                <a href="/users/logout" class="nav-link-custom">
                    <i class="bi bi-box-arrow-right"></i> Logout
                </a>
            }
            else
            {
                <a href="/users/login" class="nav-link-custom">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </a>
                <a href="/users/register" class="nav-link-custom">
                    <i class="bi bi-person-plus-fill"></i> Register
                </a>
            }
        </div>
    </div>

    <!-- MAIN CONTENT -->
    <div class="container-fluid main-content">
        <main role="main">
            @RenderBody()
        </main>
    </div>

    <!-- FOOTER -->
    <footer class="footer-fitgain">
        <div class="container-fluid">
            <div class="footer-content">
                <div>
                    <span class="footer-brand">🏋️ FitGain</span>
                </div>
                <div class="footer-text">
                    Built with 💪 &copy; @DateTime.Now.Year FitGain. All rights reserved.
                </div>
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
