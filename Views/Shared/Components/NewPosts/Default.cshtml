@model List<Post>

<div class="glass-card-static sidebar-widget">
    <div class="sidebar-widget-title">
        <i class="bi bi-fire"></i> New Posts
    </div>
    @foreach(var post in Model)
    {
        <div class="sidebar-post-item">
            <a href="/posts/details/@post.Url">
                @post.Title
            </a>
        </div>
    }
</div>