@model RegisterViewModel

<div class="auth-container">
    <div class="auth-card" style="max-width: 480px;">
        <div class="glass-card-static animate-fade-in-up" style="padding: 2.5rem;">
            <div class="auth-header">
                <div class="auth-logo">🏋️ FitGain</div>
                <p class="auth-subtitle">Join the community. Start your journey.</p>
            </div>

            <form action="Register" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="UserName" class="form-label-dark"></label>
                    <input asp-for="UserName" class="form-control-dark" placeholder="Choose a username">
                    <span asp-validation-for="UserName" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Name" class="form-label-dark"></label>
                    <input asp-for="Name" class="form-control-dark" placeholder="Your full name">
                    <span asp-validation-for="Name" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label-dark"></label>
                    <input asp-for="Email" class="form-control-dark" placeholder="you@example.com">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-3">
                    <label asp-for="Password" class="form-label-dark"></label>
                    <input asp-for="Password" class="form-control-dark" placeholder="••••••••">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="ConfirmPassword" class="form-label-dark"></label>
                    <input asp-for="ConfirmPassword" class="form-control-dark" placeholder="••••••••">
                    <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-glow w-100">
                    <i class="bi bi-person-plus-fill"></i> Create Account
                </button>
            </form>

            <div class="auth-footer">
                Already have an account? <a href="/users/login">Login here</a>
            </div>
        </div>
    </div>
</div>