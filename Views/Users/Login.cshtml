@model LoginViewModel

<div class="auth-container">
    <div class="auth-card">
        <div class="glass-card-static animate-fade-in-up" style="padding: 2.5rem;">
            <div class="auth-header">
                <div class="auth-logo">🏋️ FitGain</div>
                <p class="auth-subtitle">Welcome back! Log in to continue.</p>
            </div>

            <form action="Login" method="post" novalidate>
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>
                <div class="mb-3">
                    <label asp-for="Email" class="form-label-dark"></label>
                    <input asp-for="Email" class="form-control-dark" placeholder="you@example.com">
                    <span asp-validation-for="Email" class="text-danger"></span>
                </div>
                <div class="mb-4">
                    <label asp-for="Password" class="form-label-dark"></label>
                    <input asp-for="Password" class="form-control-dark" placeholder="••••••••">
                    <span asp-validation-for="Password" class="text-danger"></span>
                </div>
                <button type="submit" class="btn-glow w-100">
                    <i class="bi bi-box-arrow-in-right"></i> Login
                </button>
            </form>

            <div class="auth-footer">
                Don't have an account? <a href="/users/register">Register here</a>
            </div>
        </div>
    </div>
</div>